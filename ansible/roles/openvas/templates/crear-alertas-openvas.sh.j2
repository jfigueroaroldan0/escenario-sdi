#!/usr/bin/env bash
# Gestionado por Ansible.
# Crea en OpenVAS (por GMP) el filtro de severidad alta, las dos alertas de
# correo, un objetivo (la víctima) y una tarea "Full and fast" con las alertas.
# Idempotente: comprueba cada objeto por su nombre y no lo duplica.
# Imprime "CREADO" cada vez que crea algo (lo usa Ansible para marcar "changed").
set -uo pipefail

DIR="{{ openvas_dir }}"
PROY="{{ openvas_proyecto }}"
USUARIO="admin"
CLAVE="{{ openvas_admin_password }}"
DEST="{{ smtp_destinatario }}"
FROM="{{ smtp_remitente }}"

# UUID fijos en todas las instalaciones de Greenbone
RF_PDF="c402cc3e-b531-11e1-9163-406186ea4fc5"   # formato de informe PDF
RF_TXT="a3810a62-1f62-11e1-9219-406186ea4fc5"   # formato de informe TXT
PORTLIST="33d0cd82-57c6-11e1-8ed1-406186ea4fc5" # All IANA assigned TCP
CONFIG="daba56c8-73ec-11df-a475-002264764cea"   # escaneo "Full and fast"
SCANNER="08b69003-5fc2-4037-a479-93b440211c73"  # OpenVAS Default

# Lanza una petición GMP y devuelve la respuesta XML completa
gmp() {
    docker compose -f "$DIR/compose.yaml" -p "$PROY" run --rm -T gvm-tools \
        gvm-cli --gmp-username "$USUARIO" --gmp-password "$CLAVE" \
        socket --socketpath /run/gvmd/gvmd.sock --xml "$1" 2>/dev/null
}

# Devuelve el id del primer objeto cuyo <name> propio es exactamente $2.
# Se parsea el XML de verdad: el <name> directo del objeto, no el del <owner>.
id_por_nombre() {   # $1=respuesta xml  $2=nombre  $3=etiqueta (alert|filter|target|task)
    printf '%s' "$1" | python3 -c "
import sys, xml.etree.ElementTree as ET
tag=sys.argv[1]; name=sys.argv[2]
try:
    root=ET.fromstring(sys.stdin.read())
except ET.ParseError:
    sys.exit(0)
for e in root.findall(tag):
    n=e.find('name')
    if n is not None and n.text==name:
        print(e.get('id')); break
" "$3" "$2"
}

# --- Filtro de severidad alta ---
F=$(id_por_nombre "$(gmp '<get_filters filter="rows=-1"/>')" "Severidad alta" filter)
if [ -z "$F" ]; then
    gmp '<create_filter><name>Severidad alta</name><type>result</type><term>severity&gt;6.9 sort-reverse=severity rows=-1</term></create_filter>' >/dev/null
    F=$(id_por_nombre "$(gmp '<get_filters filter="rows=-1"/>')" "Severidad alta" filter)
    echo "CREADO filtro Severidad alta ($F)"
fi

# --- Alerta 1: informe de cada escaneo (adjunta PDF) ---
ALERTS=$(gmp '<get_alerts filter="rows=-1"/>')
A1=$(id_por_nombre "$ALERTS" "Informe de escaneo" alert)
if [ -z "$A1" ]; then
    gmp "<create_alert><name>Informe de escaneo</name><condition>Always</condition><event>Task run status changed<data>Done<name>status</name></data></event><method>Email<data>$DEST<name>to_address</name></data><data>$FROM<name>from_address</name></data><data>[OpenVAS] Informe de la tarea '\$n'<name>subject</name></data><data>2<name>notice</name></data><data>$RF_PDF<name>notice_attach_format</name></data></method></create_alert>" >/dev/null
    echo "CREADO alerta Informe de escaneo"
fi

# --- Alerta 2: aviso solo si hay severidad alta (incluye TXT filtrado) ---
A2=$(id_por_nombre "$ALERTS" "Aviso de severidad alta" alert)
if [ -z "$A2" ]; then
    gmp "<create_alert><name>Aviso de severidad alta</name><condition>Severity at least<data>7.0<name>severity</name></data></condition><event>Task run status changed<data>Done<name>status</name></data></event><method>Email<data>$DEST<name>to_address</name></data><data>$FROM<name>from_address</name></data><data>[OpenVAS] ALERTA: vulnerabilidades de severidad alta en '\$n'<name>subject</name></data><data>0<name>notice</name></data><data>$RF_TXT<name>notice_report_format</name></data></method><filter id=\"$F\"/></create_alert>" >/dev/null
    echo "CREADO alerta Aviso de severidad alta"
fi

# Ids de las dos alertas (ya existan o recién creadas), para asociarlas a la tarea
ALERTS=$(gmp '<get_alerts filter="rows=-1"/>')
A1=$(id_por_nombre "$ALERTS" "Informe de escaneo" alert)
A2=$(id_por_nombre "$ALERTS" "Aviso de severidad alta" alert)

# --- Objetivo: la víctima ---
T=$(id_por_nombre "$(gmp '<get_targets filter="rows=-1"/>')" "Victima {{ victima_ip }}" target)
if [ -z "$T" ]; then
    gmp "<create_target><name>Victima {{ victima_ip }}</name><hosts>{{ victima_ip }}</hosts><port_list id=\"$PORTLIST\"/></create_target>" >/dev/null
    T=$(id_por_nombre "$(gmp '<get_targets filter="rows=-1"/>')" "Victima {{ victima_ip }}" target)
    echo "CREADO objetivo Victima {{ victima_ip }} ($T)"
fi

# --- Tarea Full and fast con las dos alertas ---
K=$(id_por_nombre "$(gmp '<get_tasks filter="rows=-1"/>')" "Escaneo victima" task)
if [ -z "$K" ] && [ -n "$T" ] && [ -n "$A1" ] && [ -n "$A2" ]; then
    gmp "<create_task><name>Escaneo victima</name><comment>Escenario SDI</comment><config id=\"$CONFIG\"/><target id=\"$T\"/><scanner id=\"$SCANNER\"/><alert id=\"$A1\"/><alert id=\"$A2\"/></create_task>" >/dev/null
    echo "CREADO tarea Escaneo victima"
fi

exit 0
