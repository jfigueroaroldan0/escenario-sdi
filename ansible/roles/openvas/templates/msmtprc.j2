# Gestionado por Ansible. Se monta como /etc/msmtprc dentro del contenedor gvmd.
# gvmd envía las alertas con /usr/sbin/sendmail -> msmtp usando esta configuración.
defaults
auth           on
tls            on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
syslog         LOG_MAIL

account        gmail
host           {{ smtp_host }}
port           {{ smtp_port }}
from           {{ smtp_remitente }}
user           {{ smtp_remitente }}
password       {{ smtp_password }}

account default : gmail
