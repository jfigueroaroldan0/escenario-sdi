# Gestionado por Ansible
[Unit]
Description=Vigilante de alertas de correo de OpenVAS (ejecutado en la VM)
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/openvas-mail.py
Restart=always
RestartSec=5
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
