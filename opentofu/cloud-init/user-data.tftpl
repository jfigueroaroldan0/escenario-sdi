#cloud-config
hostname: ${hostname}

users:
  - name: debian
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: users
    shell: /bin/bash
    ssh_authorized_keys:
      - ${clave_ssh}

chpasswd:
  expire: False
  users:
    - name: debian
      password: asdasd
      type: text

locale: es_ES.UTF-8
timezone: Europe/Madrid

# El teclado se configura con /etc/default/keyboard y loadkeys (runcmd).
# No se usa el módulo "keyboard" de cloud-init: en las imágenes cloud de
# Debian intenta reiniciar console-setup, que no está, y cloud-init acaba en error.
write_files:
  - path: /etc/apt/apt.conf.d/99force-ipv4
    permissions: "0644"
    content: |
      Acquire::ForceIPv4 "true";
  - path: /etc/default/keyboard
    owner: root:root
    permissions: "0644"
    content: |
      XKBMODEL="pc105"
      XKBLAYOUT="es"
      XKBVARIANT=""
      XKBOPTIONS=""
      BACKSPACE="guess"

# Espera a tener red, instala kbd y aplica el teclado español en la consola
runcmd:
  # runcmd usa /bin/sh (dash), que no entiende {1..15}: se usa seq
  - for i in $(seq 15); do ping -c1 8.8.8.8 && break || sleep 2; done
  - for i in $(seq 10); do getent hosts deb.debian.org && break || sleep 2; done
  - DEBIAN_FRONTEND=noninteractive apt-get update -o Acquire::ForceIPv4=true || true
  - DEBIAN_FRONTEND=noninteractive apt-get install -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" kbd || true
  - loadkeys es || true
  - 'command -v setupcon >/dev/null 2>&1 && setupcon || true'
  - localectl set-locale LANG=es_ES.UTF-8 || true
